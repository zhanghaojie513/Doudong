<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Dougong.Kernel\Dougong.Kernel.csproj" />
    <ProjectReference Include="..\..\samples\Dougong.Sample.Shared\Dougong.Sample.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只保证样例插件先构建，不引用其程序集：动态加载路径必须走真实 ALC。 -->
    <ProjectReference Include="..\..\samples\Dougong.Sample.Plugin\Dougong.Sample.Plugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\samples\Dougong.Sample.Contracts\Dougong.Sample.Contracts.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- 只保构建顺序；测试项目不能引用 Dougong.Sample.Isolated，否则默认 ALC 中会出现该契约，
         漏配登记就不再必然失败，回归测试会静默失效。 -->
    <ProjectReference Include="..\..\samples\Dougong.Sample.IsolatedPlugin\Dougong.Sample.IsolatedPlugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
